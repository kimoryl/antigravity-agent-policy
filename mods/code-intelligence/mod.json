{
  "schema_version": 1,
  "id": "code-intelligence",
  "name": "代码智能分析与多语言 CodeGraph Mod (Code Intelligence v2.1)",
  "version": "2.1.0",
  "category": "code-analysis",
  "description": "七工具静态多语言 CodeGraph：增量 SQLite 缓存、SCIP 跨仓库协议索引与 OpenAPI/Proto 路由契约自动缝合、跨语言调用链追踪、PageRank RepoMap 与 JSON 基线健康门禁。",
  "tags": [
    "ast",
    "codegraph",
    "polyglot",
    "scip",
    "openapi",
    "grpc",
    "cross-boundary",
    "sqlite-cache",
    "code-search",
    "symbol-trace",
    "impact-analysis",
    "architecture"
  ],
  "source": "upgraded_path_b_polyglot_codegraph",
  "skills": [
    {
      "name": "code-intelligence",
      "description": "多语言 AST 符号搜索、调用追踪、架构提取与增量 SQLite CodeGraph 探索指南",
      "path": "skills/code-intelligence/SKILL.md"
    }
  ],
  "mcp_servers": {
    "code_intelligence": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "${MOD_DIR}/mcp/mcp_server.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  },
  "mcp_tools": [
    {
      "name": "code_search",
      "description": "Search project symbols and files through Polyglot CodeGraph AST (Python, TS/JS, Go, Rust, C#, Java, C/C++) with incremental SQLite cache.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_root": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "max_results": {
            "type": "integer"
          },
          "provider": {
            "type": "string",
            "description": "Optional provider ('polyglot' default, or 'python_ast')"
          }
        },
        "required": [
          "project_root",
          "query"
        ]
      },
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "max_results": {
            "type": "integer"
          },
          "provider": {
            "type": "string",
            "description": "Optional provider ('polyglot' default, or 'python_ast')"
          }
        },
        "required": [
          "project_root",
          "query"
        ]
      }
    },
    {
      "name": "symbol_trace",
      "description": "Trace callers and callees for a project symbol or HTTP/gRPC/SCIP contract across Python, TS/JS, Go, Rust, C#, Java, and C/C++.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_root": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "callers",
              "callees",
              "both"
            ]
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "project_root",
          "symbol"
        ]
      },
      "parameters": {
        "type": "object",
        "properties": {
          "project_root": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "callers",
              "callees",
              "both"
            ]
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "project_root",
          "symbol"
        ]
      }
    },
    {
      "name": "impact_analysis",
      "description": "Analyze affected files, transitive callers/subclasses, and related tests for a change.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_root": {
            "type": "string"
          },
          "paths": {
            "type": "array",
