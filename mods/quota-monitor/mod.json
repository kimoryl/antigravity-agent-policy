    {
      "name": "quota_cognitive_mirror_sniff",
      "description": "认知镜像嗅探器：只读聚类命令、纠偏和手工工作流，按 Rule of Three 生成规则、Skill 或 MCP 固化建议。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "events": {
            "type": [
              "array",
              "null"
            ],
