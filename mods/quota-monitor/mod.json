    {
      "name": "quota_purify_cli_output",
      "description": "CLI 输出压缩净化：保留 pytest 失败、汇总 Git 变更、折叠重复日志，并执行任务级 Token 预算熔断。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "raw_output": {
            "type": "string",
            "description": "待净化的终端原始输出"
          },
          "command_hint": {
            "type": "string",
            "enum": [
              "auto",
              "pytest",
              "git_status",
              "git_diff",
              "build_log",
              "generic"
            ],
            "default": "auto"
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1,
            "default": 80
          },
          "token_budget": {
            "type": "integer",
            "minimum": 1,
            "default": 1200
          }
        },
        "required": [
          "raw_output"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "raw_output": {
