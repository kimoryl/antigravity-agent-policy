    {
      "name": "quota_task_guard",
      "description": "进展感知型长任务守卫（正常推进总消耗不封顶）：通过 advance_step 在节点完成时重置单步计数，仅拦截同一节点无进展空烧（默认单步 15%/10%）、连续打回死循环（2 次升级 Carbon）、180s 进程停滞，并在跌破 10% 池底余量时温和挂起等待回血（park_for_refill）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "check",
              "advance_step",
              "record_reject",
              "status",
              "reset"
            ],
            "description": "守卫动作：start 初始化、check 巡检空转与池底线、advance_step 节点完成重置单步锚点、record_reject 记录打回、status 查看、reset 清理"
          },
          "task_id": {
            "type": "string",
            "description": "绑定的任务唯一 ID"
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "advance_step 时记录已完成的 DAG 节点 ID"
          },
          "max_step_gemini_delta_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.5,
            "default": null,
            "description": "单步无进展最大 Gemini 5h 消耗百分比（默认 15.0，节点完成后归零）"
          },
          "max_step_codex_delta_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.5,
            "default": null,
            "description": "单步无进展最大 Codex 5h 消耗百分比（默认 10.0，节点完成后归零）"
          },
          "max_gemini_5h_delta_pct": {
            "type": "number",
            "minimum": 0.5,
            "default": 15.0
          },
          "max_codex_5h_delta_pct": {
            "type": "number",
            "minimum": 0.5,
            "default": 10.0
          },
          "max_total_gemini_delta_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1.0,
            "default": null,
            "description": "整单总消耗上限（默认 null 不封顶，保障健康长任务不断流）"
          },
          "max_total_codex_delta_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 1.0,
            "default": null,
            "description": "整单 Codex 总消耗上限（默认 null 不封顶）"
          },
          "min_gemini_reserve_pct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 95.0,
            "default": 10.0,
            "description": "Gemini 5h 池底保命余量线（低于此值返回 park_for_refill 温和挂起等刷新）"
          },
          "min_codex_reserve_pct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 95.0,
            "default": 10.0,
            "description": "Codex 5h 池底保命余量线"
          },
          "max_reject_rounds": {
            "type": "integer",
            "minimum": 1,
            "default": 2
          },
          "stall_timeout_sec": {
            "type": "integer",
            "minimum": 10,
            "default": 180
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "description": "可选：被监控的无头 CLI 子进程 PID"
          },
          "watch_paths": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "default": null,
            "description": "可选：被监控的 CLI 日志文件或隔离工作区目录列表"
          },
          "reject_reason": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "action",
          "task_id"
        ],
        "additionalProperties": false
      },
