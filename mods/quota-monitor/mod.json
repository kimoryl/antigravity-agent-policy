      }
    },
    {
      "name": "quota_check_agent",
      "description": "快速检查单个指定智能体（AGY-CLI / Opus-CLI / Codex-CLI）的实时剩余额度、容量分级及是否可派发新任务。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_name": {
            "type": "string",
            "description": "智能体名称（AGY-CLI、Opus-CLI 或 Codex-CLI）"
          }
        },
        "required": [
          "agent_name"
        ],
        "additionalProperties": false
      },
      "parameters": {
