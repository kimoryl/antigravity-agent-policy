{
  "schema_version": 1,
  "id": "quota-monitor",
  "name": "Quota Monitor 多智能体实时额度与负载均衡监控套件",
  "version": "1.4.0",
  "category": "orchestration",
  "description": "实时监控 Antigravity 主控统领的三大 CLI 智能体（AGY-CLI、Codex-CLI、Opus-CLI）及三大底层模型池（Antigravity Gemini、Antigravity Claude/3P [支持 Claude Ultra 动态窗口]、OpenAI Codex）的剩余额度百分比、重置倒计时、Prompt Cache 5m TTL (Cache Tax) 状态与在途任务负载。",
  "tags": [
    "quota",
    "rate-limit",
    "usage",
    "dispatch",
    "routing",
    "scheduler",
    "balance",
    "cache-tax",
    "额度",
    "剩余额度",
    "限流",
    "调度"
  ],
  "skills": [
    {
      "name": "quota-monitor",
      "description": "实时查询三大 CLI 智能体（AGY-CLI、Codex-CLI、Opus-CLI）及三大底层模型池的剩余额度百分比、重置倒计时与 Prompt Cache TTL 准则，支持额度感知型智能调度。",
      "path": "skills/quota-monitor/SKILL.md"
    }
  ],
  "mcp_servers": {
    "quota-monitor": {
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "${MOD_DIR}/mcp/quota_monitor_mcp.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  },
  "mcp_tools": [
    {
      "name": "quota_status",
      "description": "实时查询 三大 CLI 智能体（AGY-CLI、Opus-CLI、Codex-CLI）及三大底层模型池的剩余额度百分比、容量体量分级（Gemini 海量无周限额主力池 vs Opus/Sol 周限额精锐池）、重置倒计时与在途任务负载。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_raw_models": {
            "type": "boolean",
            "description": "是否返回所有细分模型的原始配额桶列表（默认 false）"
          }
        },
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "include_raw_models": {
            "type": "boolean",
            "description": "是否返回所有细分模型的原始配额桶列表（默认 false）"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "quota_recommend_agent",
      "description": "额度感知型智能调度推荐器（遵循 Gemini-First, Elite-On-Demand 策略）：综合 Gemini 海量无周限额主力加权、任务专长特征词、5h/周窗口实时剩余额度与在途并发数，推荐最优执行智能体。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_description": {
            "type": "string",
            "description": "待派发的任务描述或需求摘要"
          },
          "preferred_agent": {
            "type": "string",
            "description": "可选的首选智能体名称（如 AGY-CLI、Opus-CLI、Codex-CLI）"
          },
          "min_quota_percent": {
            "type": "number",
            "description": "最低安全剩余额度百分比阈值（默认 15.0）"
          }
        },
        "required": [
          "task_description"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
