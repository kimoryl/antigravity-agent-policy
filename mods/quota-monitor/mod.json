                  "type": "string"
                },
                "correction": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "duration_sec": {
                  "type": "number",
                  "minimum": 0
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "cli_command",
                    "user_correction",
                    "manual_workflow"
                  ]
                }
              },
              "additionalProperties": true
            },
            "default": null
          },
          "trace_paths": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "default": null
          },
          "min_repeat_threshold": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          }
        },
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
